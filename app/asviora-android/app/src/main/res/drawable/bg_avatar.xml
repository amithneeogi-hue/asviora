<?xml version="1.0" encoding="utf-8"?>
<!-- Gold-to-lime ring, like the logo's circle. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="sweep"
                android:startColor="#F0C860"
                android:centerColor="#8FCE3F"
                android:endColor="#F0C860" />
        </shape>
    </item>
    <item android:left="2.5dp" android:top="2.5dp" android:right="2.5dp" android:bottom="2.5dp">
        <shape android:shape="oval">
            <gradient android:angle="270"
                android:startColor="#2A2C31"
                android:endColor="#111214" />
        </shape>
    </item>
</layer-list>
