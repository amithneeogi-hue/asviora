<?xml version="1.0" encoding="utf-8"?>
<!-- Everything tappable gives a little under the finger. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="0.96"
                android:duration="120" android:valueType="floatType" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="0.96"
                android:duration="120" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1"
                android:duration="220" android:valueType="floatType"
                android:interpolator="@android:anim/overshoot_interpolator" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1"
                android:duration="220" android:valueType="floatType"
                android:interpolator="@android:anim/overshoot_interpolator" />
        </set>
    </item>
</selector>
