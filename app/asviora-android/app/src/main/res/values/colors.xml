<?xml version="1.0" encoding="utf-8"?>
<!--
  Asviora — v4: the exact palette of the website (assets/css/style.css :root),
  so the app and asviora.in look like one product. Same logo family as v3.1.

  The logo is a metallic gold "A" and a lime-green "S", ring and crown on a
  brushed charcoal ground, lit from above. So is the app:
    grounds  = charcoal, lighter at the top like the logo's spotlight
    lime     = anything you can act on (the S / ring / crown)
    gold     = anything you have won or that matters (the A)
  No blues or purples — nothing that is not in the mark.
-->
<resources>
    <!-- charcoal grounds, back to front -->
    <color name="bg">#0B0C0E</color>
    <color name="bg2">#121317</color>
    <color name="surface">#17191D</color>
    <color name="surface2">#202329</color>
    <color name="surface3">#2E3239</color>

    <!-- glass -->
    <color name="glass">#B317191D</color>
    <color name="glass_line">#26FFFFFF</color>
    <color name="glass_hi">#14FFFFFF</color>

    <!-- lines -->
    <color name="line">#2E3239</color>
    <color name="line_soft">#23262C</color>

    <!-- type (warm white, like the logo's silver tagline) -->
    <color name="text">#EAEEE8</color>
    <color name="muted">#A2AB99</color>
    <color name="dim">#757D6D</color>

    <!-- lime — the S, the ring, the crown -->
    <color name="green">#8FCE3F</color>
    <color name="green_bright">#B6E857</color>
    <color name="green_dark">#4A7616</color>
    <color name="green_deep">#22380E</color>
    <color name="green_ghost">#268FCE3F</color>

    <!-- gold — the A -->
    <color name="gold">#D9A63C</color>
    <color name="gold_bright">#F0C860</color>
    <color name="gold_dark">#A97722</color>
    <color name="gold_deep">#4A3414</color>
    <color name="gold_ghost">#26D9A63C</color>

    <!-- supporting tones, all from the same family -->
    <color name="cyan">#B6E857</color>       <!-- kept for old references: soft lime -->
    <color name="bronze">#C98A3E</color>
    <color name="danger">#FB5C7D</color>
    <color name="danger_ghost">#24FB5C7D</color>

    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="ink">#0B0C0E</color>
    <color name="scrim">#CC08090B</color>

    <!-- the icon's own ground, so the splash and the launcher match -->
    <color name="icon_bg">#0B0C0E</color>
</resources>
