<?xml version="1.0" encoding="utf-8"?>
<!-- Shared confirm sheet: leave a game, quit a level, restart. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:background="@drawable/bg_dialog"
    android:paddingStart="24dp" android:paddingEnd="24dp"
    android:paddingTop="28dp" android:paddingBottom="22dp">

    <FrameLayout android:layout_width="64dp" android:layout_height="64dp"
        android:background="@drawable/bg_dialog_icon">
        <ImageView android:id="@+id/dIcon"
            android:layout_width="30dp" android:layout_height="30dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_exit"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView android:id="@+id/dTitle"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="16dp" style="@style/H1"
        android:textSize="21sp" android:gravity="center" />

    <TextView android:id="@+id/dBody"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" style="@style/Muted"
        android:textSize="14sp" android:gravity="center" />

    <Button android:id="@+id/dStay"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="22dp" style="@style/Primary" />

    <Button android:id="@+id/dLeave"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" style="@style/Ghost.Danger" />
</LinearLayout>
