<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_app">

    <!-- top bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/topbar_h"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="16dp"
        android:layout_marginTop="8dp">

        <ImageButton android:id="@+id/back"
            style="@style/IconButton"
            android:src="@drawable/ic_back" android:contentDescription="@string/back" />

        <TextView android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:layout_marginStart="12dp"
            style="@style/TopTitle" android:text="@string/govt_exam" />
    </LinearLayout>

    <include layout="@layout/view_topbar_divider" />

<ScrollView
    android:layout_width="match_parent" android:layout_height="0dp"
    android:layout_weight="1" android:scrollbars="none">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">

        <TextView android:id="@+id/count" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:background="@drawable/bg_pill" android:paddingLeft="14dp"
            android:paddingRight="14dp" android:paddingTop="6dp" android:paddingBottom="6dp"
            android:textColor="@color/gold_bright" android:textSize="12sp"
            android:textStyle="bold" android:text="Opening soon" />

        <TextView android:id="@+id/heading" android:layout_width="wrap_content"
            android:layout_height="wrap_content" style="@style/Display"
            android:textSize="30sp" android:layout_marginTop="12dp"
            android:text="@string/govt_exam" />

        <TextView android:id="@+id/tagline" android:layout_width="match_parent"
            android:layout_height="wrap_content" style="@style/Muted"
            android:textSize="15sp" android:layout_marginTop="6dp" />

        <TextView android:id="@+id/blurb" android:layout_width="match_parent"
            android:layout_height="wrap_content" style="@style/Muted"
            android:layout_marginTop="14dp" android:lineSpacingExtra="4dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            style="@style/H2" android:layout_marginTop="26dp"
            android:text="Tell us when to call you" />

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            style="@style/Muted" android:layout_marginTop="4dp"
            android:text="One email the day it opens. Nothing else." />

        <EditText android:id="@+id/name" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="14dp"
            android:hint="Your name" android:inputType="textPersonName"
            android:background="@drawable/bg_field" android:padding="16dp"
            android:textColor="@color/text" android:textColorHint="@color/dim"
            android:autofillHints="name" />

        <EditText android:id="@+id/email" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:hint="Email" android:inputType="textEmailAddress"
            android:background="@drawable/bg_field" android:padding="16dp"
            android:textColor="@color/text" android:textColorHint="@color/dim"
            android:autofillHints="emailAddress" />

        <EditText android:id="@+id/phone" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:hint="Phone (optional)" android:inputType="phone"
            android:background="@drawable/bg_field" android:padding="16dp"
            android:textColor="@color/text" android:textColorHint="@color/dim"
            android:autofillHints="phone" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            style="@style/Muted" android:layout_marginTop="14dp"
            android:text="Which exam are you preparing for?" />

        <Spinner android:id="@+id/stream" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:background="@drawable/bg_field" android:padding="10dp" />

        <EditText android:id="@+id/note" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:hint="Anything you want us to cover (optional)"
            android:inputType="textMultiLine" android:maxLines="3"
            android:background="@drawable/bg_field" android:padding="16dp"
            android:textColor="@color/text" android:textColorHint="@color/dim" />

        <TextView android:id="@+id/message" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:visibility="gone" android:textSize="13sp"
            android:textColor="@color/danger" />

        <Button android:id="@+id/submit" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="Notify me" style="@style/Primary" />
    </LinearLayout>
</ScrollView>
</LinearLayout>
