<?xml version="1.0" encoding="utf-8"?>
<!--
  v4 — secure payment screen. The website's pay.php runs in this WebView
  (Razorpay / Cashfree checkout), under the same native top bar the game
  screen has: [ ← ]  Secure payment
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_topbar"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="@dimen/topbar_h"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="12dp" android:paddingEnd="16dp">

            <ImageButton android:id="@+id/payBack"
                style="@style/IconButton"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView android:id="@+id/payTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    style="@style/TopTitle" android:text="@string/secure_payment" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:textColor="@color/green_bright" android:textSize="11sp"
                    android:textStyle="bold" android:letterSpacing="0.06"
                    android:text="@string/pay_partners" />
            </LinearLayout>

            <ImageView android:layout_width="22dp" android:layout_height="22dp"
                android:src="@drawable/ic_star"
                android:alpha="0.8"
                android:importantForAccessibility="no" />
        </LinearLayout>

        <ProgressBar android:id="@+id/payLine"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="2dp"
            android:max="100" android:progress="0"
            android:progressDrawable="@drawable/bg_progress" />
    </LinearLayout>

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">
        <WebView android:id="@+id/payWeb"
            android:layout_width="match_parent" android:layout_height="match_parent" />

        <TextView android:id="@+id/payError"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:padding="32dp"
            android:background="@color/bg"
            style="@style/Muted"
            android:visibility="gone"
            android:text="@string/pay_offline" />
    </FrameLayout>
</LinearLayout>
