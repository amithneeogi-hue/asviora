<?xml version="1.0" encoding="utf-8"?>
<!-- The logo's ring: gold sweeping into lime. Spun slowly behind the emblem. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="ring"
    android:innerRadiusRatio="2.35"
    android:thicknessRatio="26"
    android:useLevel="false">
    <gradient android:type="sweep"
        android:startColor="#00D9A63C"
        android:centerColor="#FFD9A63C"
        android:endColor="#FFB6E857"
        android:useLevel="false" />
</shape>
