<?xml version="1.0" encoding="utf-8"?>
<!--
  The game screen.

  A native top bar owns navigation, so the game page never has to:
    [ ← ]  Title / subtitle                     [ ⟳ ] [ ⛶ ]
  Back is always top-left where the thumb expects it; restart and full
  screen sit top-right, away from the board. In full screen the bar slides
  away and a small floating button brings it back.

  Under the bar, the WebView, and on top of it the branded cover that hides
  the white flash a WebView paints before the game is ready.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!-- ===== top bar ===== -->
    <LinearLayout android:id="@+id/topBar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_topbar"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="@dimen/topbar_h"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="12dp" android:paddingEnd="12dp">

            <ImageButton android:id="@+id/btnBack"
                style="@style/IconButton"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back" />

            <FrameLayout android:layout_width="38dp" android:layout_height="38dp"
                android:layout_marginStart="12dp">
                <TextView android:id="@+id/gameIcon"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:gravity="center" android:textSize="20sp"
                    android:background="@drawable/bg_icon_chip" />
                <!-- v4: the game's picture -->
                <ImageView android:id="@+id/gameIconImg"
                    android:layout_width="match_parent" android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_icon_chip"
                    android:importantForAccessibility="no" />
            </FrameLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="10dp" android:layout_marginEnd="8dp">

                <TextView android:id="@+id/gameTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    style="@style/TopTitle" />

                <TextView android:id="@+id/gameSub"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:drawableStart="@drawable/ic_coin_sm"
                    android:drawablePadding="4dp"
                    android:textColor="@color/gold_bright" android:textSize="11sp"
                    android:textStyle="bold" android:letterSpacing="0.06"
                    android:maxLines="1" android:ellipsize="end"
                    android:gravity="center_vertical"
                    android:text="@string/play_now" />
            </LinearLayout>

            <ImageButton android:id="@+id/btnRestart"
                style="@style/IconButton"
                android:src="@drawable/ic_refresh"
                android:contentDescription="@string/restart" />

            <ImageButton android:id="@+id/btnFull"
                style="@style/IconButton"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_fullscreen"
                android:contentDescription="@string/fullscreen" />
        </LinearLayout>

        <!-- page-load progress, drawn as a neon line under the bar -->
        <ProgressBar android:id="@+id/loadLine"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="2dp"
            android:max="100" android:progress="0"
            android:progressDrawable="@drawable/bg_progress" />
    </LinearLayout>

    <!-- ===== board ===== -->
    <FrameLayout
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1">

        <WebView android:id="@+id/web"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@color/bg" />

        <!-- the cover -->
        <FrameLayout android:id="@+id/cover"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="@drawable/bg_brand_glow"
            android:clickable="true" android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical" android:gravity="center_horizontal">

                <FrameLayout android:layout_width="200dp" android:layout_height="200dp">

                    <View android:id="@+id/coverGlow"
                        android:layout_width="match_parent" android:layout_height="match_parent"
                        android:background="@drawable/bg_glow_disc" />

                    <View android:id="@+id/coverRing"
                        android:layout_width="170dp" android:layout_height="170dp"
                        android:layout_gravity="center"
                        android:background="@drawable/bg_glow_ring" />

                    <ImageView android:id="@+id/coverLogo"
                        android:layout_width="118dp" android:layout_height="118dp"
                        android:layout_gravity="center"
                        android:src="@drawable/logo_mark"
                        android:contentDescription="@string/app_name" />
                </FrameLayout>

                <TextView android:id="@+id/coverTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" style="@style/H1"
                    android:textSize="24sp" />

                <TextView android:id="@+id/coverNote"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="6dp" style="@style/Label"
                    android:textColor="@color/muted"
                    android:gravity="center"
                    android:paddingStart="32dp" android:paddingEnd="32dp"
                    android:text="@string/loading" />

                <ImageView
                    android:layout_width="150dp" android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:adjustViewBounds="true" android:alpha="0.9"
                    android:src="@drawable/logo_wordmark"
                    android:importantForAccessibility="no" />

                <ProgressBar android:id="@+id/coverBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="180dp" android:layout_height="5dp"
                    android:layout_marginTop="20dp"
                    android:max="100" android:progress="8"
                    android:progressDrawable="@drawable/bg_progress" />

                <Button android:id="@+id/coverRetry"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:visibility="gone"
                    android:text="@string/retry" style="@style/Primary" />
            </LinearLayout>
        </FrameLayout>

        <!-- brings the bar back in full screen -->
        <ImageButton android:id="@+id/btnExitFull"
            style="@style/IconButton"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:alpha="0.85"
            android:elevation="10dp"
            android:visibility="gone"
            android:src="@drawable/ic_fullscreen_exit"
            android:contentDescription="@string/fullscreen" />
    </FrameLayout>
</LinearLayout>
