<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/bg_app">

    <!-- top bar -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/topbar_h"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:paddingStart="12dp" android:paddingEnd="16dp"
        android:layout_marginTop="8dp">

        <ImageButton android:id="@+id/back"
            style="@style/IconButton"
            android:src="@drawable/ic_back" android:contentDescription="@string/back" />

        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView android:id="@+id/title" android:layout_width="wrap_content"
                android:layout_height="wrap_content" style="@style/TopTitle"
                android:textSize="20sp" android:text="Levels" />

            <TextView android:id="@+id/subtitle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" style="@style/Muted"
                android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>

        <ImageView android:layout_width="30dp" android:layout_height="30dp"
            android:src="@drawable/ic_star"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <include layout="@layout/view_topbar_divider" />

    <TextView android:id="@+id/error" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="16dp"
        android:paddingStart="@dimen/gutter" android:paddingEnd="@dimen/gutter"
        android:visibility="gone" android:textColor="@color/danger" android:textSize="13sp" />

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/grid"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="14dp" android:paddingEnd="14dp"
        android:paddingTop="14dp"
        android:clipToPadding="false" android:paddingBottom="24dp"
        android:overScrollMode="never"
        android:layoutAnimation="@anim/layout_rise" />
</LinearLayout>
