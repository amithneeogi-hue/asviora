<?xml version="1.0" encoding="utf-8"?>
<!--
  The shell. Pages scroll full-height underneath a floating glass tab bar;
  a soft fade keeps the last card from colliding with it.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <FrameLayout android:id="@+id/host"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <View android:layout_width="match_parent" android:layout_height="120dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_nav_fade" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp" android:layout_marginEnd="14dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_nav"
        android:elevation="16dp"
        android:paddingTop="2dp" android:paddingBottom="2dp"
        app:backgroundTint="@null"
        app:itemIconTint="@color/nav_item"
        app:itemTextColor="@color/nav_item"
        app:itemIconSize="24dp"
        app:itemRippleColor="@color/green_ghost"
        app:itemActiveIndicatorStyle="@style/NavIndicator"
        app:itemTextAppearanceActive="@style/NavLabel"
        app:itemTextAppearanceInactive="@style/NavLabel"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />
</FrameLayout>
