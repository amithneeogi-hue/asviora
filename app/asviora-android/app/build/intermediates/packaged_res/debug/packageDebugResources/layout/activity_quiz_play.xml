<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_app">

    <LinearLayout android:id="@+id/playBox"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- top bar: quit on the left, where people look for "get me out" -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/topbar_h"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="12dp" android:paddingEnd="14dp"
            android:layout_marginTop="8dp">

            <ImageButton android:id="@+id/quit"
                style="@style/IconButton"
                android:src="@drawable/ic_close"
                android:contentDescription="Quit" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView android:id="@+id/step" android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/TopTitle" android:text="Question 1" />
                <TextView android:id="@+id/coins" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textColor="@color/gold_bright"
                    android:textStyle="bold" android:textSize="12sp" />
            </LinearLayout>

            <TextView android:id="@+id/timer" android:layout_width="52dp"
                android:layout_height="52dp" android:gravity="center"
                android:background="@drawable/bg_timer" android:textColor="@color/text"
                android:fontFamily="sans-serif-black" android:textSize="18sp"
                android:text="30" />
        </LinearLayout>

        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="8dp"
            android:layout_marginStart="@dimen/gutter" android:layout_marginEnd="@dimen/gutter"
            android:layout_marginTop="8dp" android:max="10" android:progress="0"
            android:progressDrawable="@drawable/bg_progress" />

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="16dp"
            android:scrollbars="none" android:overScrollMode="never">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/gutter" android:paddingEnd="@dimen/gutter">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" style="@style/Card.Hero"
                    android:layout_marginBottom="20dp">
                    <TextView android:id="@+id/question" android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text"
                        android:fontFamily="sans-serif-medium" android:textStyle="bold"
                        android:textSize="19sp" android:lineSpacingExtra="5dp"
                        android:text="@string/loading" />
                </LinearLayout>

                <LinearLayout android:id="@+id/options" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical"
                    android:layoutAnimation="@anim/layout_rise" />

                <TextView android:id="@+id/feedback" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:visibility="gone"
                    style="@style/Muted" android:textSize="14sp"
                    android:background="@drawable/bg_card" android:padding="14dp"
                    android:layout_marginTop="6dp" android:layout_marginBottom="16dp" />
            </LinearLayout>
        </ScrollView>

        <!-- the one action, full width at the bottom, in thumb reach -->
        <Button android:id="@+id/next" android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter" android:layout_marginEnd="@dimen/gutter"
            android:layout_marginTop="8dp" android:layout_marginBottom="20dp"
            android:visibility="gone"
            android:text="Next question" style="@style/Primary" />
    </LinearLayout>

    <ScrollView android:id="@+id/resultBox" android:layout_width="match_parent"
        android:layout_height="match_parent" android:visibility="gone"
        android:background="@drawable/bg_brand_glow"
        android:padding="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal">

            <TextView android:id="@+id/rStars" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="50sp"
                android:letterSpacing="0.1"
                android:textColor="@color/gold" android:layout_marginTop="48dp" />

            <TextView android:id="@+id/rTitle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" style="@style/H1"
                android:gravity="center"
                android:layout_marginTop="10dp" />

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:gravity="center_horizontal"
                android:layout_marginTop="20dp" style="@style/Card.Hero">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    style="@style/Label" android:textColor="#B3FFFFFF" android:text="Score" />

                <TextView android:id="@+id/rScore" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="54sp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/green_bright"
                    android:layout_marginTop="2dp" />

                <TextView android:id="@+id/rSub" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/Muted"
                    android:textColor="#D9FFFFFF"
                    android:gravity="center" android:layout_marginTop="4dp" />
            </LinearLayout>

            <TextView android:id="@+id/rBonus"
                style="@style/Chip.Gold"
                android:textSize="13sp"
                android:paddingTop="8dp" android:paddingBottom="8dp"
                android:visibility="gone"
                android:layout_marginTop="16dp" />

            <Button android:id="@+id/rAgain" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="28dp"
                android:text="Next level" style="@style/Primary" />

            <Button android:id="@+id/rDone" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="Back to the map" style="@style/Ghost" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
