# Uploads must never execute as code.
php_flag engine off
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>

# Only serve image files from this folder
<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|phps|pht|cgi|pl|py|sh|htaccess)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

Options -Indexes
AddType text/plain .php .phtml .php3
