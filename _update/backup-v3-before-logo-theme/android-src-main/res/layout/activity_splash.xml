<?xml version="1.0" encoding="utf-8"?>
<!-- First screen: the logo on a halo, a slowly turning neon ring, the name,
     and the status line. SplashActivity animates it in. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/bg_brand_glow">

    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical" android:gravity="center_horizontal"
        android:padding="28dp">

        <FrameLayout android:layout_width="230dp" android:layout_height="230dp">
            <View android:id="@+id/glow"
                android:layout_width="match_parent" android:layout_height="match_parent"
                android:background="@drawable/bg_glow_disc" />
            <View android:id="@+id/ring"
                android:layout_width="196dp" android:layout_height="196dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_glow_ring" />
            <ImageView android:id="@+id/logo"
                android:layout_width="140dp" android:layout_height="140dp"
                android:layout_gravity="center"
                android:src="@drawable/logo_mark"
                android:contentDescription="@string/app_name" />
        </FrameLayout>

        <TextView android:id="@+id/brand"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/app_name" style="@style/Display"
            android:textSize="34sp" android:textColor="@color/green_bright" />

        <TextView android:id="@+id/tag"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="4dp" style="@style/Label"
            android:textColor="@color/muted"
            android:text="@string/tagline" />

        <ProgressBar android:id="@+id/spinner"
            android:layout_width="28dp" android:layout_height="28dp"
            android:layout_marginTop="34dp"
            android:indeterminateTint="@color/green" />

        <TextView android:id="@+id/status"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center"
            android:text="@string/loading" style="@style/Muted" />

        <Button android:id="@+id/update"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:visibility="gone"
            android:text="@string/update" style="@style/Primary" />

        <Button android:id="@+id/later"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:visibility="gone"
            android:text="@string/later" style="@style/Ghost" />

        <Button android:id="@+id/retry"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:visibility="gone"
            android:text="@string/retry" style="@style/Primary" />
    </LinearLayout>
</FrameLayout>
