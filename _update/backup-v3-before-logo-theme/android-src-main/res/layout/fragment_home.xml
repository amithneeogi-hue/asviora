<?xml version="1.0" encoding="utf-8"?>
<!--
  The landing tab (v3).

  Header with avatar and live coin chip, an aurora hero card for balance and
  rank, a swipeable "Quick play" rail of games, and four gradient tiles as
  the ways in. Every id the fragment reads from v2 is still here.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:scrollbars="none" android:overScrollMode="never"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/nav_clearance">

    <LinearLayout android:id="@+id/homeRoot"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="12dp">

        <!-- ===== header ===== -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="@dimen/gutter" android:paddingEnd="@dimen/gutter"
            android:layout_marginTop="12dp">

            <TextView android:id="@+id/avatarInitial"
                android:layout_width="50dp" android:layout_height="50dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center" android:text="A"
                android:textColor="@color/text" android:textSize="20sp"
                android:fontFamily="sans-serif-black" />

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="12dp">
                <TextView android:id="@+id/hello"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    style="@style/Label" android:text="Welcome back" />
                <TextView android:id="@+id/greet" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/H1"
                    android:maxLines="1" android:ellipsize="end"
                    android:layout_marginTop="1dp" android:text="Player" />
            </LinearLayout>

            <TextView android:id="@+id/coinChip"
                style="@style/Chip.Gold"
                android:textSize="13sp"
                android:paddingTop="7dp" android:paddingBottom="7dp"
                android:drawableStart="@drawable/ic_coin_sm"
                android:text="0" />
        </LinearLayout>

        <!-- ===== hero: coins + rank ===== -->
        <FrameLayout android:id="@+id/hero"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter" android:layout_marginEnd="@dimen/gutter"
            android:layout_marginTop="20dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical"
                style="@style/Card.Hero">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    style="@style/Label" android:textColor="#B3FFFFFF"
                    android:text="Your balance" />

                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="4dp">
                    <ImageView android:id="@+id/heroCoin"
                        android:layout_width="34dp" android:layout_height="34dp"
                        android:src="@drawable/ic_coin_gold"
                        android:importantForAccessibility="no" />
                    <TextView android:id="@+id/coins" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" style="@style/Stat"
                        android:textSize="40sp"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/gold_bright" android:text="0" />
                </LinearLayout>

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginTop="16dp">
                    <TextView android:id="@+id/level"
                        style="@style/Chip.Green"
                        android:drawableStart="@drawable/ic_bolt_sm"
                        android:text="Level 1" />
                    <View android:layout_width="0dp" android:layout_height="1dp"
                        android:layout_weight="1" />
                    <TextView android:id="@+id/xp" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" style="@style/Muted"
                        android:textColor="#CCFFFFFF" android:textSize="12sp" />
                </LinearLayout>

                <ProgressBar android:id="@+id/xpBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent" android:layout_height="8dp"
                    android:layout_marginTop="12dp"
                    android:max="100" android:progress="0"
                    android:progressDrawable="@drawable/bg_progress" />
            </LinearLayout>

            <ImageView android:layout_width="96dp" android:layout_height="96dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="-6dp" android:layout_marginEnd="-4dp"
                android:alpha="0.16" android:rotation="12"
                android:src="@drawable/ic_trophy"
                android:elevation="11dp"
                android:importantForAccessibility="no" />
        </FrameLayout>

        <!-- ===== quick play ===== -->
        <LinearLayout android:id="@+id/quickHead" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:paddingStart="@dimen/gutter" android:paddingEnd="@dimen/gutter"
            android:layout_marginTop="28dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" style="@style/H2" android:textSize="18sp"
                android:fontFamily="sans-serif-black" android:text="Quick play" />
            <TextView android:id="@+id/seeAll"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:padding="6dp"
                android:textColor="@color/green" android:textSize="13sp"
                android:textStyle="bold" android:text="@string/see_all"
                android:background="?android:attr/selectableItemBackgroundBorderless" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView android:id="@+id/featured"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="@dimen/gutter" android:paddingEnd="10dp"
            android:layoutAnimation="@anim/layout_rise" />

        <TextView android:id="@+id/featuredEmpty"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingStart="@dimen/gutter" android:paddingEnd="@dimen/gutter"
            style="@style/Muted" android:text="@string/loading" />

        <!-- ===== explore ===== -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/gutter"
            style="@style/H2" android:textSize="18sp" android:fontFamily="sans-serif-black"
            android:layout_marginTop="26dp" android:text="Explore" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp" android:paddingEnd="14dp"
            android:layout_marginTop="8dp">

            <!-- quiz -->
            <LinearLayout android:id="@+id/goQuiz"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_margin="6dp"
                android:minHeight="156dp"
                android:orientation="vertical" android:padding="16dp"
                android:background="@drawable/bg_tile_quiz"
                android:elevation="6dp"
                android:stateListAnimator="@animator/press_scale"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_icon_chip" android:padding="10dp"
                    android:src="@drawable/ic_quiz" android:tint="@color/white"
                    android:importantForAccessibility="no" />
                <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    style="@style/H2" android:textSize="17sp" android:text="Quiz levels" />
                <TextView android:id="@+id/quizLine" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/Muted"
                    android:textColor="#D9FFFFFF" android:textSize="12sp"
                    android:layout_marginTop="2dp" android:text="Carry on where you left off" />
            </LinearLayout>

            <!-- spin -->
            <LinearLayout android:id="@+id/goSpin"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_margin="6dp"
                android:minHeight="156dp"
                android:orientation="vertical" android:padding="16dp"
                android:background="@drawable/bg_tile_spin"
                android:elevation="6dp"
                android:stateListAnimator="@animator/press_scale"
                android:clickable="true" android:focusable="true">
                <ImageView android:id="@+id/spinIcon"
                    android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_icon_chip" android:padding="10dp"
                    android:src="@drawable/ic_spin" android:tint="@color/white"
                    android:importantForAccessibility="no" />
                <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    style="@style/H2" android:textSize="17sp" android:text="Daily spin" />
                <TextView android:id="@+id/spinLine" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/Muted"
                    android:textColor="#D9FFFFFF" android:textSize="12sp"
                    android:layout_marginTop="2dp" android:text="Check your spins" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="14dp" android:paddingEnd="14dp">

            <!-- games -->
            <LinearLayout android:id="@+id/goGames"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_margin="6dp"
                android:minHeight="156dp"
                android:orientation="vertical" android:padding="16dp"
                android:background="@drawable/bg_tile_games"
                android:elevation="6dp"
                android:stateListAnimator="@animator/press_scale"
                android:clickable="true" android:focusable="true">
                <ImageView android:layout_width="44dp" android:layout_height="44dp"
                    android:background="@drawable/bg_icon_chip" android:padding="10dp"
                    android:src="@drawable/ic_games" android:tint="@color/white"
                    android:importantForAccessibility="no" />
                <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    style="@style/H2" android:textSize="17sp" android:text="Games" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    style="@style/Muted" android:textColor="#D9FFFFFF" android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:text="Chess, Sudoku, Memory, 3D cube" />
            </LinearLayout>

            <!-- govt exam (hidden when the module is off) -->
            <LinearLayout android:id="@+id/goExam"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:layout_margin="6dp"
                android:minHeight="156dp"
                android:orientation="vertical" android:padding="16dp"
                android:background="@drawable/bg_tile_exam"
                android:elevation="6dp"
                android:stateListAnimator="@animator/press_scale"
                android:clickable="true" android:focusable="true"
                android:visibility="gone">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <ImageView android:layout_width="44dp" android:layout_height="44dp"
                        android:background="@drawable/bg_icon_chip" android:padding="10dp"
                        android:src="@drawable/ic_school"
                        android:importantForAccessibility="no" />
                    <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />
                    <TextView android:id="@+id/examBadge"
                        style="@style/Chip.Gold"
                        android:textSize="10sp"
                        android:text="@string/soon" />
                </LinearLayout>
                <View android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />
                <TextView android:id="@+id/examTitle"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    style="@style/H2" android:textSize="17sp"
                    android:text="@string/govt_exam" />
                <TextView android:id="@+id/examLine" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/Muted"
                    android:textColor="#D9FFFFFF" android:textSize="12sp"
                    android:layout_marginTop="2dp"
                    android:text="WBCS, SSC, Railway, Banking — coming soon" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
