<?xml version="1.0" encoding="utf-8"?>
<!-- The one card per screen that matters: a violet-to-teal aurora with a
     gold glint in the corner and a bright glass rim. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315"
                android:startColor="#3B1F7A"
                android:centerColor="#1B2A5E"
                android:endColor="#0E4A45" />
            <corners android:radius="@dimen/radius_hero" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial"
                android:gradientRadius="60%p"
                android:centerX="1.0" android:centerY="0.0"
                android:startColor="#55FFC94D"
                android:centerColor="#14FFC94D"
                android:endColor="#00000000" />
            <corners android:radius="@dimen/radius_hero" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial"
                android:gradientRadius="55%p"
                android:centerX="0.0" android:centerY="1.0"
                android:startColor="#409BE15D"
                android:endColor="#00000000" />
            <corners android:radius="@dimen/radius_hero" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="@dimen/radius_hero" />
            <stroke android:width="1dp" android:color="#40FFFFFF" />
        </shape>
    </item>
</layer-list>
