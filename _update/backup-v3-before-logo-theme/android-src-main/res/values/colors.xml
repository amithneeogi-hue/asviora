<?xml version="1.0" encoding="utf-8"?>
<!--
  Asviora — premium palette (v3).

  Deep midnight grounds, glass surfaces, the brand green for anything you can
  act on and gold for anything you have won. On top of that each game and
  each tab gets its own neon pair, used only in gradients and glows, so the
  app feels alive without the controls ever changing colour.
-->
<resources>
    <!-- grounds, back to front -->
    <color name="bg">#06080E</color>
    <color name="bg2">#0C101A</color>
    <color name="surface">#121826</color>
    <color name="surface2">#1A2233</color>
    <color name="surface3">#232D42</color>

    <!-- glass -->
    <color name="glass">#B3121826</color>
    <color name="glass_line">#26FFFFFF</color>
    <color name="glass_hi">#14FFFFFF</color>

    <!-- lines -->
    <color name="line">#27314A</color>
    <color name="line_soft">#161E2E</color>

    <!-- type -->
    <color name="text">#F1F5FB</color>
    <color name="muted">#98A3B8</color>
    <color name="dim">#65718A</color>

    <!-- brand accents -->
    <color name="green">#9BE15D</color>
    <color name="green_bright">#B9F27C</color>
    <color name="green_dark">#3E9B4F</color>
    <color name="green_ghost">#249BE15D</color>

    <color name="gold">#FFC94D</color>
    <color name="gold_bright">#FFE08A</color>
    <color name="gold_dark">#E08A1E</color>
    <color name="gold_ghost">#24FFC94D</color>

    <color name="cyan">#4FD1FF</color>
    <color name="violet">#8B5CF6</color>
    <color name="pink">#FF4FA3</color>
    <color name="orange">#FF8A3D</color>
    <color name="danger">#FF5C7A</color>
    <color name="danger_ghost">#24FF5C7A</color>

    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="ink">#0A0F05</color>
    <color name="scrim">#CC04060B</color>

    <!-- the icon's own ground, so the splash and the launcher match -->
    <color name="icon_bg">#0D1118</color>
</resources>
