<?xml version="1.0" encoding="utf-8"?>
<!-- Splash / game-loading ground: charcoal with a lime-and-gold halo behind
     the emblem. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/bg_app" />
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="55%p"
                android:centerX="0.5" android:centerY="0.40"
                android:startColor="#38A6D83E"
                android:centerColor="#14E8BE55"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
