<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33FFFFFF">
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:angle="315"
                        android:startColor="#E8BE55"
                        android:centerColor="#5E4118"
                        android:endColor="#141518" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <gradient android:type="radial"
                        android:gradientRadius="45%p"
                        android:centerX="1.0" android:centerY="0.0"
                        android:startColor="#38FFFFFF"
                        android:endColor="#00FFFFFF" />
                    <corners android:radius="24dp" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#00000000" />
                    <corners android:radius="24dp" />
                    <stroke android:width="1dp" android:color="#80F7DC7C" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFFFF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</ripple>
