<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:scrollbars="none" android:overScrollMode="never"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/nav_clearance">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter" android:paddingEnd="@dimen/gutter"
        android:paddingTop="24dp">

        <!-- identity -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal"
            style="@style/Card.Hero" android:paddingTop="28dp" android:paddingBottom="24dp">

            <TextView android:id="@+id/avatar"
                android:layout_width="92dp" android:layout_height="92dp"
                android:background="@drawable/bg_avatar"
                android:gravity="center" android:text="A"
                android:textColor="@color/text" android:textSize="38sp"
                android:fontFamily="sans-serif-black" />

            <TextView android:id="@+id/name" android:layout_width="wrap_content"
                android:layout_height="wrap_content" style="@style/H1"
                android:gravity="center"
                android:layout_marginTop="14dp" />

            <TextView android:id="@+id/handle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" style="@style/Muted"
                android:textColor="#CCFFFFFF" />

            <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="14dp">
                <TextView android:id="@+id/level"
                    style="@style/Chip.Green"
                    android:drawableStart="@drawable/ic_bolt_sm"
                    android:text="Level 1" />
                <TextView android:id="@+id/best"
                    style="@style/Chip.Gold"
                    android:layout_marginStart="8dp"
                    android:text="0" />
            </LinearLayout>
        </LinearLayout>

        <!-- stats -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="14dp">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:gravity="center" style="@style/Card"
                android:paddingTop="16dp" android:paddingBottom="16dp">
                <ImageView android:layout_width="26dp" android:layout_height="26dp"
                    android:src="@drawable/ic_coin_gold" android:importantForAccessibility="no" />
                <TextView android:id="@+id/coins" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/Stat"
                    android:textSize="22sp" android:layout_marginTop="6dp"
                    android:textColor="@color/gold_bright" android:text="0" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    style="@style/Label" android:text="Coins" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="10dp"
                android:gravity="center" style="@style/Card"
                android:paddingTop="16dp" android:paddingBottom="16dp">
                <ImageView android:layout_width="26dp" android:layout_height="26dp"
                    android:src="@drawable/ic_games" android:tint="@color/green"
                    android:importantForAccessibility="no" />
                <TextView android:id="@+id/rounds" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/Stat"
                    android:textSize="22sp" android:layout_marginTop="6dp"
                    android:textColor="@color/text" android:text="0" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    style="@style/Label" android:text="Rounds" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:layout_marginStart="10dp"
                android:gravity="center" style="@style/Card"
                android:paddingTop="16dp" android:paddingBottom="16dp">
                <ImageView android:layout_width="26dp" android:layout_height="26dp"
                    android:src="@drawable/ic_star" android:importantForAccessibility="no" />
                <TextView android:id="@+id/levelsPassed" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/Stat"
                    android:textSize="22sp" android:layout_marginTop="6dp"
                    android:textColor="@color/green_bright" android:text="0" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    style="@style/Label" android:text="Levels" />
            </LinearLayout>
        </LinearLayout>

        <!-- recent -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            style="@style/H2" android:textSize="18sp" android:fontFamily="sans-serif-black"
            android:layout_marginTop="26dp" android:text="Recent rounds" />
        <LinearLayout android:id="@+id/recent" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="10dp" style="@style/Card"
            android:paddingTop="6dp" android:paddingBottom="6dp"
            android:showDividers="middle" android:divider="@drawable/bg_divider" />

        <!-- wallet -->
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            style="@style/H2" android:textSize="18sp" android:fontFamily="sans-serif-black"
            android:layout_marginTop="26dp" android:text="Coin history" />
        <LinearLayout android:id="@+id/wallet" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="10dp" style="@style/Card"
            android:paddingTop="6dp" android:paddingBottom="6dp"
            android:showDividers="middle" android:divider="@drawable/bg_divider" />

        <Button android:id="@+id/logout" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="28dp"
            android:text="@string/logout" style="@style/Ghost.Danger" />
    </LinearLayout>
</ScrollView>
