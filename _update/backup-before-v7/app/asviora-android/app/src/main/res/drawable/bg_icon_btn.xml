<?xml version="1.0" encoding="utf-8"?>
<!-- Round metal button for the top bars (back, restart, full screen). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#4DA6D83E">
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270"
                android:startColor="#3A3D43"
                android:endColor="#1C1D21" />
            <stroke android:width="1dp" android:color="#59E8BE55" />
        </shape>
    </item>
</ripple>
