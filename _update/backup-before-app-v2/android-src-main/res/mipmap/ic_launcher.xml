<?xml version="1.0" encoding="utf-8"?>
<!--
  Fallback launcher icon for devices below API 26, which do not
  understand adaptive icons. Same two shapes, drawn flat.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/bg" />
    <item android:drawable="@drawable/ic_launcher_fg"
          android:top="12dp" android:bottom="12dp"
          android:left="12dp" android:right="12dp" />
</layer-list>
