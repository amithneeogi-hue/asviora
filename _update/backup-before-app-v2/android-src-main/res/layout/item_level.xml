<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="92dp"
    android:orientation="vertical" android:gravity="center"
    android:layout_margin="5dp" android:background="@drawable/bg_level_locked"
    android:clickable="true" android:focusable="true">

    <TextView android:id="@+id/no" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="22sp"
        android:textStyle="bold" android:textColor="@color/text" />

    <TextView android:id="@+id/stars" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="12sp"
        android:textColor="@color/gold" android:layout_marginTop="2dp" />

    <TextView android:id="@+id/sub" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="10sp"
        android:textColor="@color/muted" android:layout_marginTop="2dp" />
</LinearLayout>
