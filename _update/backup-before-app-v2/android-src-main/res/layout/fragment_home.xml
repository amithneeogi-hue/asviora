<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">

        <TextView android:id="@+id/greet" android:layout_width="wrap_content"
            android:layout_height="wrap_content" style="@style/H1"
            android:layout_marginTop="14dp" android:text="Hello" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="16dp"
            style="@style/Card">

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/coins" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="30sp"
                    android:textStyle="bold" android:textColor="@color/gold" android:text="0" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    style="@style/Muted" android:text="Coins" />
            </LinearLayout>

            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical">
                <TextView android:id="@+id/level" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:textSize="20sp"
                    android:textStyle="bold" android:textColor="@color/green"
                    android:text="Level 1" />
                <TextView android:id="@+id/xp" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" style="@style/Muted" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/goQuiz" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="14dp" style="@style/Card" android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                style="@style/H2" android:text="Quiz levels" />
            <TextView android:id="@+id/quizLine" android:layout_width="wrap_content"
                android:layout_height="wrap_content" style="@style/Muted"
                android:layout_marginTop="4dp" android:text="Carry on where you left off" />
        </LinearLayout>

        <LinearLayout android:id="@+id/goSpin" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="12dp" style="@style/Card" android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                style="@style/H2" android:text="Daily spin" />
            <TextView android:id="@+id/spinLine" android:layout_width="wrap_content"
                android:layout_height="wrap_content" style="@style/Muted"
                android:layout_marginTop="4dp" android:text="Check your spins" />
        </LinearLayout>

        <LinearLayout android:id="@+id/goGames" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="12dp" style="@style/Card" android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                style="@style/H2" android:text="Games" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                style="@style/Muted" android:layout_marginTop="4dp"
                android:text="Chess, Sudoku, Memory and the 3D cube" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
