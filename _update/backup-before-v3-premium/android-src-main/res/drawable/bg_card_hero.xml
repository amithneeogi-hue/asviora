<?xml version="1.0" encoding="utf-8"?>
<!-- The one card per screen that matters most: the same surface, warmed
     towards the brand green and edged in it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="235"
                      android:startColor="#222E1C"
                      android:centerColor="#1A2230"
                      android:endColor="#141B26" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#33556B24" />
        </shape>
    </item>
</layer-list>
