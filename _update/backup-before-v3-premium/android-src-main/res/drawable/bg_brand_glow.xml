<?xml version="1.0" encoding="utf-8"?>
<!-- The ground the logo sits on: brand dark, lifted in the middle by a
     radial the same green as the mark, so the screen has a centre. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="62%p"
                android:centerX="0.5" android:centerY="0.42"
                android:startColor="#2A8FCE3F"
                android:centerColor="#0F8FCE3F"
                android:endColor="#00000000" />
        </shape>
    </item>
</layer-list>
