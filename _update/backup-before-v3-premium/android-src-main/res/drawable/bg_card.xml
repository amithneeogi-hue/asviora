<?xml version="1.0" encoding="utf-8"?>
<!-- A card lifts off the ground with a gradient rather than a shadow: on a
     near-black screen a drop shadow is invisible, but a surface that is a
     shade lighter at the top reads as raised. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient android:angle="270"
              android:startColor="#1B2331"
              android:endColor="#131924" />
    <corners android:radius="18dp" />
    <stroke android:width="1dp" android:color="@color/line" />
</shape>
