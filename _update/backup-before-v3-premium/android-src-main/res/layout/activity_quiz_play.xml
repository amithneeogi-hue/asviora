<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout android:id="@+id/playBox"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="vertical" android:padding="16dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">

            <TextView android:id="@+id/step" android:layout_width="0dp"
                android:layout_height="wrap_content" android:layout_weight="1"
                style="@style/H2" android:text="Question 1" />

            <TextView android:id="@+id/coins" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textColor="@color/gold"
                android:textSize="13sp" android:layout_marginEnd="12dp" />

            <TextView android:id="@+id/timer" android:layout_width="46dp"
                android:layout_height="46dp" android:gravity="center"
                android:background="@drawable/bg_pill" android:textColor="@color/green"
                android:textStyle="bold" android:text="30" />
        </LinearLayout>

        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="6dp"
            android:layout_marginTop="12dp" android:max="10" android:progress="0" />

        <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:layout_marginTop="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView android:id="@+id/question" android:layout_width="match_parent"
                    android:layout_height="wrap_content" style="@style/H2"
                    android:textSize="18sp" android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="18dp" android:text="@string/loading" />

                <LinearLayout android:id="@+id/options" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:orientation="vertical" />

                <TextView android:id="@+id/feedback" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:visibility="gone"
                    style="@style/Muted" android:layout_marginTop="8dp" />
            </LinearLayout>
        </ScrollView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:layout_marginTop="12dp">

            <Button android:id="@+id/quit" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Quit" style="@style/Ghost" />

            <View android:layout_width="0dp" android:layout_height="1dp"
                android:layout_weight="1" />

            <Button android:id="@+id/next" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:visibility="gone"
                android:text="Next question" style="@style/Primary" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView android:id="@+id/resultBox" android:layout_width="match_parent"
        android:layout_height="match_parent" android:visibility="gone" android:padding="24dp">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:gravity="center_horizontal">

            <TextView android:id="@+id/rStars" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="34sp"
                android:textColor="@color/gold" android:layout_marginTop="40dp" />

            <TextView android:id="@+id/rTitle" android:layout_width="wrap_content"
                android:layout_height="wrap_content" style="@style/H1"
                android:layout_marginTop="10dp" />

            <TextView android:id="@+id/rScore" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:textSize="46sp"
                android:textStyle="bold" android:textColor="@color/green"
                android:layout_marginTop="12dp" />

            <TextView android:id="@+id/rSub" android:layout_width="wrap_content"
                android:layout_height="wrap_content" style="@style/Muted"
                android:gravity="center" android:layout_marginTop="6dp" />

            <TextView android:id="@+id/rBonus" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:visibility="gone"
                android:textColor="@color/gold" android:layout_marginTop="14dp" />

            <Button android:id="@+id/rAgain" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="28dp"
                android:text="Next level" style="@style/Primary" />

            <Button android:id="@+id/rDone" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="Back to the map" style="@style/Ghost" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
