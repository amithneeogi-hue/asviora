<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">

    <FrameLayout android:id="@+id/host"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- a hairline, so the bar reads as a separate surface rather than the
         page running off the bottom of the screen -->
    <View android:layout_width="match_parent" android:layout_height="1dp"
        android:background="@color/line_soft" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/nav"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@color/bg2"
        app:elevation="0dp"
        app:itemIconTint="@color/nav_item"
        app:itemTextColor="@color/nav_item"
        app:itemActiveIndicatorStyle="@style/NavIndicator"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav" />
</LinearLayout>
