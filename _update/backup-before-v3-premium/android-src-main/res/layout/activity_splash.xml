<?xml version="1.0" encoding="utf-8"?>
<!-- The first thing anyone sees. The logo rather than the word, on the same
     ground the launcher icon uses, so opening the app looks like the icon
     growing into a screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center"
    android:background="@drawable/bg_brand_glow" android:padding="28dp">

    <ImageView android:id="@+id/logo"
        android:layout_width="140dp" android:layout_height="140dp"
        android:src="@drawable/logo_mark"
        android:contentDescription="@string/app_name" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/app_name" style="@style/H1"
        android:textSize="26sp" android:textColor="@color/green" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="4dp" style="@style/Label"
        android:text="@string/tagline" />

    <TextView android:id="@+id/status"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="26dp" android:gravity="center"
        android:text="@string/loading" style="@style/Muted" />

    <Button android:id="@+id/update"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:visibility="gone"
        android:text="@string/update" style="@style/Primary" />

    <Button android:id="@+id/later"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:visibility="gone"
        android:text="@string/later" style="@style/Ghost" />

    <Button android:id="@+id/retry"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="18dp" android:visibility="gone"
        android:text="@string/retry" style="@style/Primary" />
</LinearLayout>
