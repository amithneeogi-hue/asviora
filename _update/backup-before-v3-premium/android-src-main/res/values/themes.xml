<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.Asviora" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/green</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/gold</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorHighlight">@color/green_ghost</item>
    </style>

    <style name="Theme.Asviora.Splash" parent="Theme.Asviora">
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <!-- ==========================================================
         Surfaces
         ========================================================== -->

    <style name="Card">
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:padding">18dp</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- A card that is the point of its screen: the coin balance, the
         result of a round. One per screen, or it stops meaning anything. -->
    <style name="Card.Hero">
        <item name="android:background">@drawable/bg_card_hero</item>
        <item name="android:padding">20dp</item>
        <item name="android:elevation">4dp</item>
    </style>

    <!-- ==========================================================
         Type
         ========================================================== -->

    <style name="H1">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">23sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>

    <style name="H2">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Muted">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Small, spaced, upper case: the label above a number, never a
         sentence. -->
    <style name="Label">
        <item name="android:textColor">@color/dim</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <style name="Stat">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <!-- ==========================================================
         Controls
         ========================================================== -->

    <style name="Primary" parent="Widget.Material3.Button">
        <item name="android:textColor">@color/black</item>
        <item name="backgroundTint">@color/green</item>
        <item name="rippleColor">@color/black</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">26dp</item>
        <item name="android:elevation">3dp</item>
    </style>

    <style name="Ghost" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textColor">@color/text</item>
        <item name="strokeColor">@color/line</item>
        <item name="rippleColor">@color/green_ghost</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">24dp</item>
    </style>

    <!-- The pill behind the selected tab icon. -->
    <style name="NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/green_ghost</item>
    </style>
</resources>
